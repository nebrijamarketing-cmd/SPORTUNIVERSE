<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="SportUniverse: articoli per ogni sport.">
  <title>SportUniverse | Il tuo sport. Il tuo universo.</title>
  <link rel="stylesheet" href="style.css">
  <script src="script.js" defer></script>
