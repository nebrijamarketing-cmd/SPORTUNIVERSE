<body>
<header class="header"><a class="logo" href="#home">SPORT<span>UNIVERSE</span></a><nav aria-label="Navigazione principale"><a href="#sport">Sport</a><a href="#prodotti">Prodotti</a><a href="#chisiamo">Chi siamo</a><a href="#contatti">Contatti</a></nav><button class="cart-button" id="cartButton" type="button">🛒 Carrello <span id="cartCount">0</span></button></header>
<main><section class="hero" id="home"><div class="hero-content"><span class="eyebrow">ATTREZZATI PER OGNI SFIDA</span><h1>IL TUO SPORT.<br><em>IL TUO UNIVERSO.</em></h1><p>Dalla prima corsa alla prossima vittoria: scopri articoli per ogni passione sportiva.</p><a class="primary-button" href="#prodotti">Scopri i prodotti ↗</a></div><div class="hero-art" aria-hidden="true">⚽<span>🏀</span><small>🏆</small></div></section>
<section class="section" id="sport"><div class="section-heading"><span class="eyebrow">TROVA LA TUA PASSIONE</span><h2>Ogni sport, un universo.</h2></div><div class="sports-grid" id="sportsGrid"></div></section>
<section class="section products-section" id="prodotti"><div class="section-heading"><span class="eyebrow">LA NOSTRA SELEZIONE</span><h2>Prodotti in evidenza</h2><p>Articoli dimostrativi con prezzi di esempio.</p></div><div class="filters" id="filters" aria-label="Filtra prodotti"></div><div class="products-grid" id="productsGrid"></div></section>
<section class="about" id="chisiamo"><div><span class="eyebrow">CHI SIAMO</span><h2>La passione ci mette in movimento.</h2><p>SportUniverse nasce da un'idea semplice: rendere lo sport accessibile a tutti. Che tu ami il calcio, il nuoto, la palestra o il ciclismo, qui trovi ispirazione per la tua prossima avventura.</p></div><div class="about-icon" aria-hidden="true">🌍</div></section>
<section class="section contact" id="contatti"><span class="eyebrow">RESTA IN CONTATTO</span><h2>Hai una domanda?</h2><p>Scrivici a <a href="mailto:info@sportuniverse.example">info@sportuniverse.example</a></p><p class="note">Indirizzo email dimostrativo, non attivo.</p></section></main>
<footer><strong>SPORT<span>UNIVERSE</span></strong><p>Il tuo sport. Il tuo universo. © <span id="year"></span></p><small>Sito dimostrativo: nessun ordine o pagamento reale.</small></footer>
<dialog id="cartDialog" aria-labelledby="cartTitle"><div class="dialog-head"><h2 id="cartTitle">Il tuo carrello</h2><button id="closeCart" aria-label="Chiudi carrello">✕</button></div><div id="cartItems"></div><p class="total" id="cartTotal"></p><p class="note">Questo è un carrello dimostrativo. Non è possibile completare acquisti.</p></dialog>
</body></html>

:root{--bg:#0b0e0d;--panel:#161b18;--lime:#b8ff3b;--text:#f6f8f4;--muted:#a8b2a9}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}.header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 6%;border-bottom:1px solid #273029;position:sticky;top:0;background:#0b0e0df5;z-index:2}.logo,footer strong{font-weight:900;letter-spacing:-1px;font-size:23px}.logo span,footer strong span{color:var(--lime)}nav{display:flex;gap:24px}nav a{font-size:14px;color:#d2d9d1}nav a:hover{color:var(--lime)}.cart-button{border:1px solid #4d5a4e;border-radius:30px;background:transparent;color:white;padding:11px 16px}.cart-button span{color:var(--lime);font-weight:bold}.hero{min-height:540px;padding:90px 7%;display:flex;align-items:center;justify-content:space-between;gap:30px;background:radial-gradient(circle at 78% 45%,#314b1c 0%,#151d13 34%,#0b0e0d 72%)}.hero-content{max-width:680px}.eyebrow{color:var(--lime);font-size:12px;letter-spacing:3px;font-weight:bold}h1{font-size:clamp(48px,7vw,94px);line-height:.98;letter-spacing:-4px;margin:24px 0}h1 em{color:var(--lime);font-style:normal}p{line-height:1.7;color:var(--muted)}.hero p{max-width:490px;font-size:18px}.primary-button{display:inline-block;background:var(--lime);color:#111;padding:17px 26px;border-radius:8px;font-weight:800;margin-top:20px}.hero-art{font-size:clamp(90px,14vw,210px);transform:rotate(-15deg);white-space:nowrap;filter:drop-shadow(0 25px 30px #0008)}.hero-art span{font-size:.55em}.hero-art small{font-size:.38em}.section{padding:85px 7%}.section-heading h2,.about h2,.contact h2{font-size:clamp(32px,4vw,50px);margin:12px 0 24px;letter-spacing:-1px}.sports-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.sport-card{background:#1a221b;border:1px solid #303b30;border-radius:12px;padding:28px 16px;text-align:center;transition:transform .2s}.sport-card:hover{transform:translateY(-4px);border-color:var(--lime)}.sport-card .emoji{font-size:43px;display:block;margin-bottom:15px}.sport-card strong{font-size:17px}.products-section{background:#101510}.filters{display:flex;flex-wrap:wrap;gap:9px;margin:28px 0}.filter{background:#202a20;color:white;border:1px solid #3c493d;border-radius:25px;padding:10px 17px}.filter.active{background:var(--lime);color:#111;border-color:var(--lime);font-weight:bold}.products-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px}.product{background:#1c241d;border:1px solid #354034;border-radius:12px;overflow:hidden}.product-visual{height:180px;display:grid;place-items:center;background:linear-gradient(145deg,#31462b,#1a231b);font-size:83px}.product-body{padding:20px}.product-body small{color:var(--lime)}.product-body h3{font-size:18px;min-height:42px;margin:10px 0}.product-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px}.price{font-size:21px;font-weight:800}.add-button{border:0;background:var(--lime);color:#111;padding:10px 13px;border-radius:7px;font-weight:bold}.about{padding:85px 7%;display:flex;align-items:center;justify-content:space-between;gap:30px;background:#202c1d}.about>div:first-child{max-width:670px}.about-icon{font-size:130px}.contact{text-align:center}.contact a{color:var(--lime);text-decoration:underline}.note{font-size:12px;color:#9ea79f}footer{padding:36px 7%;border-top:1px solid #283228}footer p{margin:8px 0}dialog{background:#1a221b;color:white;border:1px solid #607357;border-radius:15px;padding:26px;width:min(480px,90vw);max-height:80vh;overflow:auto}dialog::backdrop{background:#000a}.dialog-head{display:flex;justify-content:space-between;align-items:center}.dialog-head button{background:transparent;color:white;border:0;font-size:24px}.cart-line{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #40503d;padding:13px 0}.cart-line button{color:var(--lime);background:none;border:0}.total{font-weight:bold;color:white;font-size:20px}@media(max-width:900px){.products-grid{grid-template-columns:repeat(2,1fr)}.hero-art{display:none}.sports-grid{grid-template-columns:repeat(4,1fr)}}@media(max-width:600px){.header{flex-wrap:wrap;padding:18px 5%}.logo{font-size:20px}nav{order:3;width:100%;justify-content:space-between;gap:8px}nav a{font-size:12px}.hero{min-height:440px;padding:60px 6%}h1{letter-spacing:-2px}.section{padding:60px 5%}.sports-grid{grid-template-columns:repeat(2,1fr)}.products-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.product-visual{height:125px;font-size:60px}.product-body{padding:12px}.product-body h3{font-size:15px}.product-bottom{align-items:flex-start;flex-direction:column}.about{padding:60px 6%}.about-icon{display:none}}

const categories=[{name:'Calcio',emoji:'⚽'},{name:'Basket',emoji:'🏀'},{name:'Tennis',emoji:'🎾'},{name:'Running',emoji:'🏃'},{name:'Palestra',emoji:'🏋️'},{name:'Nuoto',emoji:'🏊'},{name:'Ciclismo',emoji:'🚴'},{name:'Altri sport',emoji:'🏆'}];
const products=[{id:1,name:'Pallone da calcio Pro',category:'Calcio',emoji:'⚽',price:29.90},{id:2,name:'Pallone da basket Street',category:'Basket',emoji:'🏀',price:34.90},{id:3,name:'Racchetta da tennis Ace',category:'Tennis',emoji:'🎾',price:79.90},{id:4,name:'Scarpe da running Speed',category:'Running',emoji:'👟',price:89.90},{id:5,name:'Manubri fitness 5 kg',category:'Palestra',emoji:'🏋️',price:39.90},{id:6,name:'Occhialini da nuoto',category:'Nuoto',emoji:'🥽',price:19.90},{id:7,name:'Casco da ciclismo',category:'Ciclismo',emoji:'🚴',price:49.90},{id:8,name:'Tappetino yoga Comfort',category:'Altri sport',emoji:'🧘',price:24.90}];
const euro=n=>n.toLocaleString('it-IT',{style:'currency',currency:'EUR'});let active='Tutti';let cart=[];
const sportsGrid=document.querySelector('#sportsGrid'),filters=document.querySelector('#filters'),productsGrid=document.querySelector('#productsGrid');
sportsGrid.innerHTML=categories.map(c=>`<a class="sport-card" href="#prodotti" data-category="${c.name}"><span class="emoji">${c.emoji}</span><strong>${c.name}</strong></a>`).join('');
function renderFilters(){filters.innerHTML=['Tutti',...categories.map(c=>c.name)].map(c=>`<button class="filter ${c===active?'active':''}" data-category="${c}" type="button">${c}</button>`).join('')}
function renderProducts(){const selected=active==='Tutti'?products:products.filter(p=>p.category===active);productsGrid.innerHTML=selected.map(p=>`<article class="product"><div class="product-visual" aria-hidden="true">${p.emoji}</div><div class="product-body"><small>${p.category}</small><h3>${p.name}</h3><div class="product-bottom"><span class="price">${euro(p.price)}</span><button class="add-button" data-id="${p.id}" type="button">+ Aggiungi</button></div></div></article>`).join('')}
function setCategory(name){active=name;renderFilters();renderProducts()}
filters.addEventListener('click',e=>{const b=e.target.closest('[data-category]');if(b)setCategory(b.dataset.category)});
sportsGrid.addEventListener('click',e=>{const a=e.target.closest('[data-category]');if(a)setCategory(a.dataset.category)});
productsGrid.addEventListener('click',e=>{const b=e.target.closest('[data-id]');if(!b)return;const p=products.find(x=>x.id===Number(b.dataset.id));if(p){cart.push(p);document.querySelector('#cartCount').textContent=cart.length;b.textContent='✓ Aggiunto';setTimeout(()=>b.textContent='+ Aggiungi',900)}});
const dialog=document.querySelector('#cartDialog');document.querySelector('#cartButton').addEventListener('click',()=>{renderCart();dialog.showModal()});document.querySelector('#closeCart').addEventListener('click',()=>dialog.close());
function renderCart(){document.querySelector('#cartItems').innerHTML=cart.length?cart.map((p,i)=>`<div class="cart-line"><span>${p.emoji} ${p.name}<br>${euro(p.price)}</span><button data-remove="${i}" type="button">Rimuovi</button></div>`).join(''):'<p>Il carrello è vuoto.</p>';document.querySelector('#cartTotal').textContent=`Totale: ${euro(cart.reduce((s,p)=>s+p.price,0))}`}
document.querySelector('#cartItems').addEventListener('click',e=>{const b=e.target.closest('[data-remove]');if(!b)return;cart.splice(Number(b.dataset.remove),1);document.querySelector('#cartCount').textContent=cart.length;renderCart()});
document.querySelector('#year').textContent=new Date().getFullYear();renderFilters();renderProducts();
